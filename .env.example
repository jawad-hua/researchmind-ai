GROQ_API_KEY=your_groq_key_here
TAVILY_API_KEY=your_tavily_key_here
LLM_MODEL=openai/gpt-oss-120b

# Frontend only: where to reach the backend API. Leave as-is for local
# (non-Docker) runs. docker-compose overrides this automatically to
# point at the backend container.
BACKEND_URL=http://localhost:8000
